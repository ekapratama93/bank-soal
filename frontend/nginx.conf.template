server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api {
        resolver ${RESOLVER} valid=10s;
        set $backend_upstream "${BACKEND_SCHEME}://${BACKEND_HOST}:${BACKEND_PORT}";
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_server_name on;
        # Quiz generation can call the AI several times per package (text,
        # then up to 3 images) across up to 5 packages — keep this in sync
        # with LONG_TIMEOUT_MS in frontend/src/api/client.ts (kept slightly
        # above this value).
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, stale-while-revalidate=86400";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache, stale-while-revalidate=86400";
        try_files $uri /index.html;
    }
}