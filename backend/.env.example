# Kunci API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model default gratis; bisa diganti, mis. openai/gpt-4o-mini
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
# Model yang mendukung image output (untuk soal yang butuh gambar/diagram).
# Model gratis untuk image generation berubah dari waktu ke waktu di OpenRouter —
# cek https://openrouter.ai/models?modality=text-%3Eimage secara berkala.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview:free

# Proyek Supabase (Auth + Storage REST API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Koneksi Postgres langsung (backend Go memakai pgx, bukan lewat PostgREST).
# Ambil dari Supabase Dashboard -> Project Settings -> Database -> Connection
# string (pakai varian "Connection pooling" / port 6543 supaya jalan dari
# Railway tanpa perlu IPv6).
DATABASE_URL=postgresql://postgres.xxxxx:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Origin frontend untuk CORS (dev). Di produksi nginx mem-proxy /api sehingga tidak diperlukan.
FRONTEND_ORIGIN=http://localhost:5173